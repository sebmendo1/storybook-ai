{
  "name": "@autodsm/csf-writer",
  "version": "0.0.0",
  "private": true,
  "description": "AST-driven CSF3 story authoring. Builds @babel/types ASTs and prints them via recast for staged story files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "code": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generate": {
      "types": "./src/generate-stub.ts",
      "code": "./src/generate-stub.ts",
      "default": "./src/generate-stub.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@autodsm/indexer": "workspace:*",
    "@autodsm/shared": "workspace:*",
    "pathe": "^2.0.0",
    "storybook": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
