{
  "name": "@autodsm/electron",
  "version": "0.0.0",
  "private": true,
  "description": "AutoDSM Electron desktop shell. Hosts a Storybook preview in a WebContentsView and bridges manager↔preview channel events over Electron IPC.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "build:main": "tsup",
    "dev": "tsup --watch --onSuccess \"electron .\"",
    "dry-run": "node ./scripts/dry-run.ts",
    "start": "electron ."
  },
  "dependencies": {
    "@autodsm/agent": "workspace:*",
    "@autodsm/channels": "workspace:*",
    "@autodsm/csf-writer": "workspace:*",
    "@autodsm/detect": "workspace:*",
    "@autodsm/indexer": "workspace:*",
    "@autodsm/preset": "workspace:*",
    "@autodsm/shared": "workspace:*",
    "pathe": "^2.0.0",
    "storybook": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "electron": "^35.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
